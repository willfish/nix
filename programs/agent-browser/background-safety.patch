diff --git i/cli/src/native/background.rs w/cli/src/native/background.rs
new file mode 100644
index 0000000..4ec05b0
--- /dev/null
+++ w/cli/src/native/background.rs
@@ -0,0 +1,208 @@
+//! Background-only CDP policy and durable proof of tab creation.
+
+use std::collections::HashSet;
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+
+use super::tab_binding;
+use crate::session_files::SessionFile;
+
+pub fn enabled() -> bool {
+    std::env::var("AGENT_BROWSER_BACKGROUND").as_deref() == Ok("1")
+}
+
+pub fn prepare(
+    method: &str,
+    params: Option<Value>,
+    background: bool,
+) -> Result<Option<Value>, String> {
+    if !background {
+        return Ok(params);
+    }
+    match method {
+        "Page.bringToFront" | "Target.activateTarget" | "Browser.setWindowBounds"
+        | "Browser.close" | "Target.sendMessageToTarget" | "Target.createBrowserContext" => Err(format!(
+            "Background-only mode refuses {method}: foreground or browser-wide access is not allowed"
+        )),
+        "Target.createTarget" => {
+            let mut params = params.unwrap_or_else(|| json!({}));
+            if params.get("newWindow").and_then(Value::as_bool) == Some(true) {
+                return Err("Background-only mode cannot open a new window".to_string());
+            }
+            let object = params.as_object_mut().ok_or("Invalid target parameters")?;
+            object.insert("background".into(), json!(true));
+            object.insert("focus".into(), json!(false));
+            object.insert("newWindow".into(), json!(false));
+            Ok(Some(params))
+        }
+        _ => Ok(params),
+    }
+}
+
+/// Untracked forwarding cannot provide durable ownership acknowledgements.
+pub fn prepare_raw(raw: String, background: bool) -> Result<String, String> {
+    if !background {
+        return Ok(raw);
+    }
+    let command: Value = serde_json::from_str(&raw).map_err(|e| e.to_string())?;
+    let method = command
+        .get("method")
+        .and_then(Value::as_str)
+        .ok_or("Missing CDP method")?;
+    if matches!(method, "Target.createTarget" | "Target.closeTarget") {
+        return Err("Background-only mode requires tracked tab creation and cleanup".to_string());
+    }
+    prepare(method, command.get("params").cloned(), true)?;
+    Ok(raw)
+}
+
+#[derive(Default, Serialize, Deserialize)]
+pub struct OwnedTabs {
+    browser: String,
+    targets: HashSet<String>,
+    #[serde(skip)]
+    session: Option<String>,
+}
+
+impl OwnedTabs {
+    pub fn load(url: &str, session: Option<String>) -> Result<Self, String> {
+        // Hash the endpoint rather than persisting URLs that may contain credentials.
+        // Chrome's browser UUID changes on restart, unlike the debugging port.
+        let browser = format!("{:x}", Sha256::digest(url.as_bytes()));
+        let mut owned = Self {
+            browser,
+            session,
+            ..Self::default()
+        };
+        if let Some(session) = owned.session.as_deref() {
+            let path = SessionFile::OwnedTargets.path(session);
+            match std::fs::read(&path) {
+                Ok(raw) => {
+                    let saved: Self = serde_json::from_slice(&raw).map_err(|e| {
+                        format!("Cannot read tab ownership {}: {e}", path.display())
+                    })?;
+                    if saved.browser == owned.browser {
+                        owned.targets = saved.targets;
+                    }
+                }
+                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+                Err(e) => return Err(format!("Cannot read tab ownership: {e}")),
+            }
+        }
+        Ok(owned)
+    }
+
+    pub fn targets(&self) -> Vec<String> {
+        self.targets.iter().cloned().collect()
+    }
+
+    pub fn contains(&self, target: &str) -> bool {
+        self.targets.contains(target)
+    }
+
+    pub fn created(&mut self, target: &str) -> Result<(), String> {
+        self.targets.insert(target.to_string());
+        self.save()
+    }
+
+    pub fn closed(&mut self, target: &str) -> Result<(), String> {
+        self.targets.remove(target);
+        self.save()?;
+        if let Some(session) = self.session.as_deref() {
+            if tab_binding::load(session)?.is_some_and(|b| b.target_id == target) {
+                tab_binding::clear(session);
+            }
+        }
+        Ok(())
+    }
+
+    fn save(&self) -> Result<(), String> {
+        if let Some(session) = self.session.as_deref() {
+            let raw = serde_json::to_string(self).map_err(|e| e.to_string())?;
+            tab_binding::save_json(&SessionFile::OwnedTargets.path(session), &raw)?;
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn background_policy_refuses_activation_and_forces_background_creation() {
+        for method in [
+            "Page.bringToFront",
+            "Target.activateTarget",
+            "Browser.close",
+            "Target.sendMessageToTarget",
+            "Target.createBrowserContext",
+        ] {
+            assert!(prepare(method, None, true)
+                .unwrap_err()
+                .contains("Background-only"));
+            assert!(prepare(method, None, false).is_ok());
+        }
+        let params = prepare(
+            "Target.createTarget",
+            Some(json!({"url":"about:blank", "focus":true, "background":false})),
+            true,
+        )
+        .unwrap()
+        .unwrap();
+        assert_eq!(params["background"], true);
+        assert_eq!(params["focus"], false);
+        assert_eq!(params["newWindow"], false);
+        assert!(prepare("Target.createTarget", Some(json!({"newWindow":true})), true).is_err());
+        assert!(prepare_raw(
+            json!({"id":-1,"method":"Page.bringToFront"}).to_string(),
+            true
+        )
+        .is_err());
+        assert!(prepare_raw(
+            json!({"id":-1,"method":"Target.createTarget"}).to_string(),
+            true
+        )
+        .is_err());
+    }
+
+    #[test]
+    fn ownership_survives_reconnect_but_does_not_adopt_bound_tabs_or_other_browsers() {
+        let guard = crate::test_utils::EnvGuard::new(&["AGENT_BROWSER_SOCKET_DIR"]);
+        let dir = tempfile::tempdir().unwrap();
+        guard.set("AGENT_BROWSER_SOCKET_DIR", dir.path().to_str().unwrap());
+        tab_binding::save(
+            "work",
+            &tab_binding::TabBinding {
+                target_id: "personal".into(),
+                url: "about:blank".into(),
+                pinned: true,
+            },
+        )
+        .unwrap();
+        let mut first = OwnedTabs::load("ws://localhost/browser/one", Some("work".into())).unwrap();
+        assert!(!first.contains("personal"));
+        first.created("agent").unwrap();
+        let mut resumed =
+            OwnedTabs::load("ws://localhost/browser/one", Some("work".into())).unwrap();
+        assert!(resumed.contains("agent"));
+        assert!(
+            !OwnedTabs::load("ws://localhost/browser/two", Some("work".into()))
+                .unwrap()
+                .contains("agent")
+        );
+        resumed.closed("agent").unwrap();
+        assert_eq!(
+            tab_binding::load("work").unwrap().unwrap().target_id,
+            "personal"
+        );
+        assert!(
+            OwnedTabs::load("ws://localhost/browser/one", Some("work".into()))
+                .unwrap()
+                .targets()
+                .is_empty()
+        );
+    }
+}
