+const CONSOLE_BYTE_LIMIT: usize = 4 * 1024 * 1024;
+const ERROR_BYTE_LIMIT: usize = 1024 * 1024;
+pub(crate) const TEXT_BYTE_LIMIT: usize = 16 * 1024;
+
+pub(crate) fn bounded_text(text: &str, limit: usize) -> String {
+    if text.len() <= limit {
+        return text.to_string();
+    }
+    let suffix = "[truncated]";
+    let mut end = limit.saturating_sub(suffix.len());
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    format!("{}{}", &text[..end], suffix)
+}
+
+/// Account for container storage as well as string payloads, not JSON output size.
+pub(crate) fn value_bytes(value: &Value) -> usize {
+    std::mem::size_of::<Value>()
+        + match value {
+            Value::String(s) => s.capacity(),
+            Value::Array(a) => a.iter().map(value_bytes).sum(),
+            Value::Object(o) => o
+                .iter()
+                .map(|(k, v)| k.capacity() + 64 + value_bytes(v))
+                .sum(),
+            _ => 0,
+        }
+}
+
+pub(crate) fn bounded_value(value: &Value, limit: usize) -> Value {
+    if value_bytes(value) <= limit {
+        value.clone()
+    } else {
+        json!({"_truncated":true})
+    }
+}
