# Immutable mode bundles copied to theme-menu/active at runtime. Keep the lock
# include variables-only: repeated Hyprlock blocks create additional widgets.
{ lib }:
let
  rgb = colour: "rgb(${colour})";
  hash = colour: "#${colour}";
  plain = colour: "${colour}ff";
  selection = (import ./render.nix { inherit lib; }).selectionPair;
in
{
  assets = [
    "hyprland.conf"
    "fuzzel.ini"
    "walker.css"
    "waybar.css"
    "hyprlock.conf"
    "gtk.css"
    "mako.conf"
    "colors.toml"
    "shell.toml"
  ];
  # Walker 2.16.2 loads themes/<name>/style.css and ignores themes/<name>.css.
  # That file must @import the published walker.css; a custom stylesheet
  # replaces the built-in default, so walker.css is the complete theme.
  walker = {
    theme = "hyprland";
    stylesheet = "walker.css";
    activePath = ".local/state/theme-menu/active/walker.css";
  };
  stateSubdir = "theme-menu";
  activeSubdir = "theme-menu/active";
  modeFile = "theme-menu/mode";

  render =
    {
      mode,
      palette,
      appearance,
      gtkTheme ? (if mode == "dark" then "adw-gtk3-dark" else "adw-gtk3"),
    }:
    let
      inherit (appearance) font;
      mono = appearance.monoFont;
      fontSize = toString appearance.fontSize;
      rounding = toString appearance.rounding;
      borderSize = toString appearance.borderSize;
      activeBorder =
        if (appearance.colors.activeBorder or null) == null then
          rgb palette.base0D
        else
          appearance.colors.activeBorder;
      inactiveBorder =
        if (appearance.colors.inactiveBorder or null) == null then
          rgb palette.base03
        else
          appearance.colors.inactiveBorder;
      colorScheme = if mode == "dark" then "prefer-dark" else "prefer-light";
      highlight = selection palette;
      # Walker and every Fuzzel picker share Nanolight's neutral palette.
      dark = mode == "dark";
      neutral = {
        text = if dark then "eeeeee" else "292929";
        sub = if dark then "b5b5b5" else "6f6f6f";
        fill = if dark then "1a1a1abd" else "ffffffc7";
        popover = if dark then "242425" else "f9f9fa";
        hair = if dark then "ffffff1f" else "00000017";
        selection = if dark then "ffffff29" else "00000014";
        rim = if dark then "ffffff1a" else "0000000d";
        tile = if dark then "ffffff17" else "0000000d";
      };
      variables = ''
        $theme_mode = ${mode}
        $theme_background = ${rgb palette.base00}
        $theme_surface = ${rgb palette.base01}
        $theme_selection = ${rgb highlight.bg}
        $theme_border = ${rgb palette.base03}
        $theme_muted = ${rgb palette.base04}
        $theme_text = ${rgb palette.base05}
        $theme_accent = ${rgb palette.base0D}
        $theme_active_border = ${activeBorder}
        $theme_inactive_border = ${inactiveBorder}
        $theme_fail = ${rgb palette.base08}
        $theme_check = ${rgb palette.base0B}
        $theme_font = ${font}
        $theme_mono_font = ${mono}
        $theme_font_size = ${fontSize}
        $theme_rounding = ${rounding}
        $theme_border_size = ${borderSize}
        $theme_gtk = ${gtkTheme}
        $theme_color_scheme = ${colorScheme}
      '';
    in
    {
      # Native Omarchy QML reads these role names through Commons/Color.qml.
      "colors.toml" = ''
        background = "${hash palette.base00}"
        foreground = "${hash palette.base05}"
        accent = "${hash palette.base0D}"
        red = "${hash palette.base08}"
        muted = "${hash palette.base04}"
      '';
      "shell.toml" = ''
        [font]
        base-size = ${toString (appearance.fontSize * 4 / 3)}
        [popups]
        background = "${hash palette.base00}"
        background-alpha = 0.94
        text = "${hash palette.base05}"
        border = "${hash palette.base0D}"
        accent = "${hash palette.base0D}"
        muted = "${hash palette.base04}"
        red = "${hash palette.base08}"
        orange = "${hash palette.base09}"
        yellow = "${hash palette.base0A}"
        green = "${hash palette.base0B}"
        teal = "${hash palette.base0C}"
        [menu]
        background = "${hash palette.base00}"
        background-alpha = 1.0
        text = "${hash palette.base05}"
        border = "${hash palette.base0D}"
        border-alpha = 1.0
        scrim = "${hash palette.base00}"
        scrim-alpha = 0.5
        selected-background = "${hash palette.base05}"
        selected-background-alpha = 0.08
        selected-text = "${hash palette.base0D}"
        selected-border = "${hash palette.base0D}"
        selected-border-alpha = 0.25
      '';
      "hyprland.conf" = ''
        # Selected mode: ${mode}. Generated by theme-menu.
        ${variables}
        general {
            border_size = ${borderSize}
            col.active_border = ${activeBorder}
            col.inactive_border = ${inactiveBorder}
        }

        decoration {
            rounding = ${rounding}
        }

        misc {
            background_color = ${rgb palette.base00}
        }
      '';
      "fuzzel.ini" = ''
        # Selected mode: ${mode}. Generated by theme-menu.
        [main]
        font=Inter:pixelsize=13.5,Symbols Nerd Font Mono:pixelsize=13.5
        dpi-aware=no
        icons-enabled=no
        keyboard-focus=on-demand
        exit-on-keyboard-focus-loss=no
        horizontal-pad=18
        vertical-pad=12
        inner-pad=8
        line-height=38px

        [colors]
        background=${neutral.fill}
        text=${plain neutral.text}
        message=${plain neutral.sub}
        prompt=${plain neutral.sub}
        placeholder=${plain neutral.sub}
        input=${plain neutral.text}
        match=${plain neutral.text}
        selection=${neutral.selection}
        selection-text=${plain neutral.text}
        selection-match=${plain neutral.text}
        counter=${plain neutral.sub}
        border=${neutral.hair}

        [border]
        width=1
        radius=18
        selection-radius=10
      '';
      # Keep Nanolight's neutral palette across themes; only light/dark follows
      # the selected mode. Geometry and type live with the GTK layouts.
      "walker.css" = ''
        /* Selected mode: ${mode}. Generated by theme-menu. */
        @define-color nl_text ${hash neutral.text};
        @define-color nl_sub ${hash neutral.sub};
        @define-color nl_fill ${hash neutral.fill};
        @define-color nl_popover ${hash neutral.popover};
        @define-color nl_hair ${hash neutral.hair};
        @define-color nl_selection ${hash neutral.selection};
        @define-color nl_rim ${hash neutral.rim};
        @define-color nl_tile ${hash neutral.tile};
      ''
      + builtins.readFile ../../config/launcher/nanolight.css;
      "waybar.css" = ''
        /* Selected mode: ${mode}. Generated by theme-menu. */
        @define-color background ${hash palette.base00};
        @define-color surface ${hash palette.base01};
        @define-color selection ${hash palette.base02};
        @define-color border ${hash palette.base03};
        @define-color muted ${hash palette.base04};
        @define-color text ${hash palette.base05};
        @define-color accent ${hash palette.base0D};
        @define-color red ${hash palette.base08};
        @define-color orange ${hash palette.base09};
        @define-color yellow ${hash palette.base0A};
        @define-color green ${hash palette.base0B};
        @define-color teal ${hash palette.base0C};
        @define-color purple ${hash palette.base0E};
        @define-color rose ${hash palette.base0F};

        * {
            font-family: "${font}", "${mono}";
            font-size: ${fontSize}pt;
            border-radius: ${rounding}px;
        }

        window#waybar {
            background: @background;
            color: @text;
            border: ${borderSize}px solid @border;
        }
      '';
      "hyprlock.conf" = ''
        # Selected mode: ${mode}. Variables only; do not add widgets here.
        ${variables}
      '';
      "mako.conf" = ''
        background-color=${hash palette.base00}
        text-color=${hash palette.base05}
        border-color=${hash palette.base0D}
        progress-color=over ${hash palette.base02}
        border-size=${borderSize}
        border-radius=${rounding}
        font=${mono} ${fontSize}
      '';
      "gtk.css" = ''
        /* Selected mode: ${mode}. Shared GTK and Brave colours and fonts. */
        @define-color theme_bg_color ${hash palette.base00};
        @define-color theme_fg_color ${hash palette.base05};
        @define-color theme_base_color ${hash palette.base01};
        @define-color theme_text_color ${hash palette.base05};
        @define-color theme_selected_bg_color ${hash highlight.bg};
        @define-color theme_selected_fg_color ${hash highlight.fg};
        @define-color accent_color ${hash palette.base0D};
        @define-color accent_bg_color ${hash palette.base0D};
        @define-color accent_fg_color ${hash palette.base00};
        @define-color window_bg_color ${hash palette.base00};
        @define-color window_fg_color ${hash palette.base05};
        @define-color view_bg_color ${hash palette.base01};
        @define-color view_fg_color ${hash palette.base05};
        @define-color headerbar_bg_color ${hash palette.base01};
        @define-color headerbar_fg_color ${hash palette.base05};
        @define-color sidebar_bg_color ${hash palette.base01};
        @define-color sidebar_fg_color ${hash palette.base05};
        @define-color card_bg_color ${hash palette.base01};
        @define-color card_fg_color ${hash palette.base05};
        @define-color popover_bg_color ${hash palette.base01};
        @define-color popover_fg_color ${hash palette.base05};
        @define-color dialog_bg_color ${hash palette.base00};
        @define-color dialog_fg_color ${hash palette.base05};
        @define-color destructive_bg_color ${hash palette.base08};
        @define-color destructive_fg_color ${hash palette.base00};
        @define-color success_color ${hash palette.base0B};
        @define-color warning_color ${hash palette.base0A};
        @define-color error_color ${hash palette.base08};

        window,
        dialog,
        .background {
            background-color: @theme_bg_color;
            color: @theme_fg_color;
        }

        /* Named colours above do not rewrite the theme's own menu rules.
           Right-click and tray menus are menu widgets, not windows. */
        menu,
        .menu,
        .context-menu {
            background-color: @popover_bg_color;
            color: @popover_fg_color;
            border-color: @accent_color;
            border-radius: ${rounding}px;
        }

        menu menuitem,
        .menu menuitem,
        .context-menu menuitem {
            background-color: transparent;
            color: @popover_fg_color;
        }

        menu menuitem:hover,
        .menu menuitem:hover,
        .context-menu menuitem:hover {
            background-color: @theme_selected_bg_color;
            color: @theme_selected_fg_color;
        }

        menu menuitem:disabled,
        .menu menuitem:disabled,
        .context-menu menuitem:disabled {
            color: alpha(@popover_fg_color, 0.45);
        }

        popover,
        popover.background {
            background-color: @popover_bg_color;
            color: @popover_fg_color;
        }

        popover modelbutton {
            background-color: transparent;
            color: @popover_fg_color;
        }

        popover modelbutton:hover {
            background-color: @theme_selected_bg_color;
            color: @theme_selected_fg_color;
        }

        * {
            font-family: "${font}", "${mono}";
        }
      '';
    };
}
