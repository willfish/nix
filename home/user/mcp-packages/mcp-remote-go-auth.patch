@@ -0,0 +1,65 @@
+package proxy
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/naotama2002/mcp-remote-go/auth"
+)
+
+func TestExplicitAuthorizationTakesPrecedenceOverCachedOAuth(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		headers map[string]string
+		want    string
+	}{
+		{"canonical header", map[string]string{"Authorization": "Bearer explicit-token"}, "Bearer explicit-token"},
+		{"lowercase header", map[string]string{"authorization": "Bearer explicit-token"}, "Bearer explicit-token"},
+		{"mixed-case header", map[string]string{"aUtHoRiZaTiOn": "Bearer explicit-token"}, "Bearer explicit-token"},
+		{"no explicit authorization", map[string]string{"X-Custom": "value"}, "Bearer cached-token"},
+		{"empty explicit authorization", map[string]string{"Authorization": ""}, "Bearer cached-token"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("MCP_REMOTE_CONFIG_DIR", t.TempDir())
+			var mu sync.Mutex
+			var posts []string
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == http.MethodPost {
+					mu.Lock()
+					posts = append(posts, r.Header.Get("Authorization"))
+					mu.Unlock()
+				}
+				w.WriteHeader(http.StatusAccepted)
+			}))
+			defer server.Close()
+
+			p, err := NewProxyWithTransport(server.URL, 3334, tc.headers, "auth-precedence", TransportModeStreamableHTTP)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer p.cancel()
+			if err := p.authCoord.SaveTokens(&auth.Tokens{AccessToken: "cached-token"}); err != nil {
+				t.Fatal(err)
+			}
+
+			transport := p.createTransport(TransportModeStreamableHTTP)
+			ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+			defer cancel()
+			if err := transport.Send(ctx, []byte(`{"jsonrpc":"2.0","method":"notifications/initialized"}`)); err != nil {
+				t.Fatal(err)
+			}
+			mu.Lock()
+			defer mu.Unlock()
+			if len(posts) == 0 {
+				t.Fatal("server received no POST")
+			}
+			if got := posts[len(posts)-1]; got != tc.want {
+				t.Errorf("outgoing Authorization = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
