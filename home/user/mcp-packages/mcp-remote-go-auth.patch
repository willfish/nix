@@ -149,0 +150,7 @@ func (p *Proxy) getAuthToken() string {
+	// Explicit credentials take precedence over a previous interactive login.
+	for name, value := range p.headers {
+		if strings.EqualFold(name, "Authorization") && value != "" {
+			return ""
+		}
+	}
+
