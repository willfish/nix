#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
usage: hmswitch [NH_HOME_SWITCH_ARGS...]

Switch this machine to the matching Home Manager configuration.
System-managed Darwin hosts deploy the matching system first (sudo may prompt).
On those hosts, supported options are --dry, --ask, --verbose, --quiet,
--no-nom and --diff, including their short forms where available.

Environment:
  HMSWITCH_FLAKE  Dotfiles flake path, default: ~/.dotfiles
USAGE
}

flake="${HMSWITCH_FLAKE:-$HOME/.dotfiles}"
darwin_system_services=false

switch_darwin_pair() {
  local arg dry ask answer system home
  dry=false
  ask=false
  for arg in "$@"; do
    case "$arg" in
      -n|--dry) dry=true ;;
      -a|--ask) ask=true ;;
      -v|--verbose|-q|--quiet|--no-nom|-d|--diff) ;;
      *)
        echo "hmswitch: unsupported paired Darwin option: $arg" >&2
        echo "Update flake inputs separately; system and home must use one built target." >&2
        return 1
        ;;
    esac
  done

  # Keep both generations rooted while waiting for sudo and home activation.
  darwin_build_dir=$(mktemp -d "${TMPDIR:-/tmp}/hmswitch.XXXXXXXX")
  trap 'rm -rf -- "$darwin_build_dir"' EXIT
  system=$(nix build --out-link "$darwin_build_dir/system" --print-out-paths \
    --no-write-lock-file "$flake#darwinConfigurations.\"$host\".system")
  home=$(< "$system/etc/dotfiles/home-generation")
  if [ ! -x "$home/activate" ]; then
    echo "hmswitch: built Darwin system lacks a usable pinned home generation" >&2
    return 1
  fi

  if [ "$(cd /run/current-system 2>/dev/null && pwd -P)" != "$system" ] ||
    [ "$(cd /nix/var/nix/profiles/system 2>/dev/null && pwd -P)" != "$system" ] ||
    [ "$(cat /etc/dotfiles/home-generation 2>/dev/null)" != "$home" ]; then
    echo "hmswitch: matching Darwin system: $system"
    if [ "$dry" = true ]; then
      echo "hmswitch: dry run; Darwin system will not be activated"
    else
      if [ "$ask" = true ]; then
        read -r -p "Deploy the Darwin system before switching home? [y/N] " answer
        case "$answer" in
          y|Y|yes|YES) ;;
          *) echo "hmswitch: cancelled" >&2; return 1 ;;
        esac
      fi
      sudo "$system/sw/bin/darwin-deploy" "$system"
    fi
  fi

  # A store installable prevents a second flake evaluation selecting another home.
  nh home switch "$home" "$@"
}

sync_darwin_nix_config() {
  local source target
  source="$flake/home/config/nix/nix.custom.conf"
  target="/etc/nix/nix.custom.conf"

  if [ ! -f "$source" ]; then
    echo "hmswitch: missing managed Nix config: $source" >&2
    return 1
  fi

  if ! cmp -s "$source" "$target"; then
    echo "hmswitch: updating trusted Nix caches"
    sudo install -o root -g wheel -m 0644 "$source" "$target"
    sudo launchctl kickstart -k system/systems.determinate.nix-daemon
  fi
}

wait_for_launchd_service_removal() {
  local label attempts
  label="$1"
  attempts=0

  while launchctl print "$label" >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 100 ]; then
      echo "hmswitch: timed out waiting for $label to stop" >&2
      return 1
    fi
    sleep 0.1
  done
}

sync_darwin_file_limits() {
  local source target label changed
  source="$HOME/.local/share/dotfiles-system/limit.maxfiles.plist"
  target="/Library/LaunchDaemons/limit.maxfiles.plist"
  label="system/limit.maxfiles"
  changed=0

  if [ ! -f "$source" ]; then
    echo "hmswitch: missing managed file-limit service: $source" >&2
    return 1
  fi

  if ! cmp -s "$source" "$target"; then
    echo "hmswitch: updating the macOS open-file limit"
    sudo install -o root -g wheel -m 0644 "$source" "$target"
    changed=1
  fi

  if [ "$changed" -eq 1 ]; then
    sudo launchctl bootout "$label" >/dev/null 2>&1 || true
    wait_for_launchd_service_removal "$label"
    sudo launchctl bootstrap system "$target"
  elif ! launchctl print "$label" >/dev/null 2>&1; then
    sudo launchctl bootstrap system "$target"
  fi
}

sync_darwin_tailscale_service() {
  local source target label changed
  source="$HOME/.local/share/dotfiles-system/io.tailscale.tailscaled.plist"
  target="/Library/LaunchDaemons/io.tailscale.tailscaled.plist"
  label="system/io.tailscale.tailscaled"
  changed=0

  if [ ! -f "$source" ]; then
    echo "hmswitch: missing managed Tailscale service: $source" >&2
    return 1
  fi

  if ! cmp -s "$source" "$target"; then
    echo "hmswitch: updating the Tailscale launch daemon"
    sudo install -d -o root -g wheel -m 0755 /var/lib/tailscale
    sudo install -o root -g wheel -m 0644 "$source" "$target"
    changed=1
  fi

  # Homebrew previously left a user agent pointing at an uninstalled formula.
  if launchctl print "gui/$(id -u)/homebrew.mxcl.tailscale" >/dev/null 2>&1; then
    launchctl bootout "gui/$(id -u)/homebrew.mxcl.tailscale" >/dev/null 2>&1 || true
    launchctl disable "gui/$(id -u)/homebrew.mxcl.tailscale" >/dev/null 2>&1 || true
  fi

  if [ "$changed" -eq 1 ]; then
    sudo launchctl bootout "$label" >/dev/null 2>&1 || true
    wait_for_launchd_service_removal "$label"
    sudo launchctl bootstrap system "$target"
  elif ! launchctl print "$label" >/dev/null 2>&1; then
    sudo launchctl bootstrap system "$target"
  fi
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

short_hostname() {
  hostname -s 2>/dev/null || hostname 2>/dev/null | cut -d. -f1
}

case "$(uname -s)" in
  Darwin)
    # Bootstrap Home Manager before the system launchd limit is installed.
    ulimit -n 65536
    host="$(short_hostname | tr '[:upper:]' '[:lower:]')"
    configuration="william-darwin"
    home_names=$(nix eval --json "$flake#homeConfigurations" --apply builtins.attrNames)
    if printf '%s\n' "$home_names" | grep -Fq "\"william@$host\""; then
      configuration="william@$host"
    fi
    darwin_system_services=$(nix eval --json "$flake#homeConfigurations.\"$configuration\".config.dotfiles.darwinSystemServices")
    case "$darwin_system_services" in
      true)
        switch_darwin_pair "$@"
        exit 0
        ;;
      false) sync_darwin_nix_config ;;
      *) echo "hmswitch: invalid Darwin service ownership" >&2; exit 1 ;;
    esac
    ;;
  Linux)
    host="$(short_hostname | tr '[:upper:]' '[:lower:]')"
    case "$host" in
      andromeda|foundation|starfish|terminus)
        configuration="william@$host"
        ;;
      *)
        configuration="william-linux"
        ;;
    esac
    ;;
  *)
    echo "hmswitch: unsupported system: $(uname -s)" >&2
    exit 1
    ;;
esac

nh home switch "$flake" --configuration "$configuration" "$@"

if [ "$(uname -s)" = Darwin ] && [ "$darwin_system_services" = false ]; then
  sync_darwin_file_limits
  sync_darwin_tailscale_service
fi
