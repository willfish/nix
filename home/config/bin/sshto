#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
usage: sshto [HOST] [--user USER] [--domain DOMAIN|--no-domain] [--session NAME] [--keybindings local|server] [--handoff] [--print] [-- HERDR_ARGS...]

Pick one of the known hosts with fzf and attach to it through Herdr remote mode.
HOST may be supplied directly to skip fzf.
Remote sessions use server keybindings by default; pass --keybindings local to override.

Environment:
  SSHTO_USER      SSH username, default: william
  SSHTO_DOMAIN    Override detected network domain
  SSHTO_FLAKE     Dotfiles flake path, default: ~/.dotfiles
  SSHTO_EXTRA_HOSTS
                  Space/newline separated extra host names, useful for Macs
                  that are not yet represented as flake host attrs
  SSHTO_HOST_ALIASES
                  Space/newline separated alias=target entries
USAGE
}

user="${SSHTO_USER:-william}"
domain="${SSHTO_DOMAIN:-}"
use_domain=1
print_only=0
host=""
session=""
keybindings="server"
handoff=0
herdr_args=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --user|-l)
      [ "$#" -ge 2 ] || {
        usage
        exit 64
      }
      user="$2"
      shift 2
      ;;
    --domain)
      [ "$#" -ge 2 ] || {
        usage
        exit 64
      }
      domain="$2"
      use_domain=1
      shift 2
      ;;
    --no-domain)
      use_domain=0
      shift
      ;;
    --print)
      print_only=1
      shift
      ;;
    --session)
      [ "$#" -ge 2 ] || {
        usage
        exit 64
      }
      session="$2"
      shift 2
      ;;
    --keybindings|--remote-keybindings)
      [ "$#" -ge 2 ] || {
        usage
        exit 64
      }
      keybindings="$2"
      shift 2
      ;;
    --handoff)
      handoff=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      herdr_args=("$@")
      break
      ;;
    -*)
      herdr_args+=("$1")
      shift
      ;;
    *)
      if [ -z "$host" ]; then
        host="$1"
      else
        herdr_args+=("$1")
      fi
      shift
      ;;
  esac
done

list_resolver_domains() {
  if command -v resolvectl >/dev/null 2>&1; then
    resolvectl domain 2>/dev/null \
      | awk -F': ' '
          NF > 1 {
            count = split($2, domains, " ")
            for (i = 1; i <= count; i++) {
              domain = domains[i]
              sub(/^~/, "", domain)
              if (domain != "" && domain != ".") {
                print domain
              }
            }
          }
        '
  fi

  if command -v hostname >/dev/null 2>&1; then
    hostname -d 2>/dev/null || true
  fi

  awk '
    /^search[[:space:]]+/ {
      for (i = 2; i <= NF; i++) {
        print $i
      }
    }
  ' "${SSHTO_RESOLV_CONF:-/etc/resolv.conf}" 2>/dev/null || true
}

detect_lan_domain() {
  list_resolver_domains \
    | sed -e 's/^~//' -e '/^[[:space:]]*$/d' \
    | awk '
        !seen[$0]++ && $0 != "." && $0 != "(none)" && $0 !~ /\.ts\.net$/ {
          print
          exit
        }
      '
}

list_hosts() {
  local flake hosts
  flake="${SSHTO_FLAKE:-$HOME/.dotfiles}"

  if [ -f "$flake/flake.nix" ] && command -v nix >/dev/null 2>&1; then
    hosts="$(SSHTO_FLAKE="$(realpath "$flake")" nix eval --impure --raw --expr '
      let
        flake = builtins.getFlake (builtins.getEnv "SSHTO_FLAKE");
        homeNames = builtins.attrNames (flake.homeConfigurations or {});
        homeHostName = name:
          if builtins.match ".*@.*" name != null then
            builtins.elemAt (builtins.split "@" name) 2
          else if name == "william-darwin" then
            "relay"
          else
            null;
        homeHosts = builtins.filter (host: host != null) (map homeHostName homeNames);
      in
        builtins.concatStringsSep "\n" ((builtins.attrNames flake.nixosConfigurations) ++ homeHosts)
    ' 2>/dev/null)" && {
      printf '%s\n' "$hosts"
      return
    }
  fi

  printf '%s\n' andromeda foundation starfish terminus relay
}

list_extra_hosts() {
  if [ -n "${SSHTO_EXTRA_HOSTS:-}" ]; then
    printf '%s\n' "$SSHTO_EXTRA_HOSTS" | tr '[:space:]' '\n'
  fi
}

list_host_aliases() {
  if [ -n "${SSHTO_HOST_ALIASES:-}" ]; then
    printf '%s\n' "$SSHTO_HOST_ALIASES" | tr '[:space:]' '\n'
  fi
}

list_alias_hosts() {
  list_host_aliases | awk -F= 'NF >= 2 && $1 != "" && $2 != "" { print $1 }'
}

alias_target() {
  local name
  name="$1"

  list_host_aliases | awk -F= -v name="$name" '
    NF >= 2 && $1 == name && $2 != "" {
      print substr($0, length($1) + 2)
      exit
    }
  '
}

current_host() {
  local name

  name="$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)"
  printf '%s\n' "${name%%.*}"
}

list_known_hosts() {
  {
    list_hosts
    list_extra_hosts
    list_alias_hosts
  } | sed '/^[[:space:]]*$/d' | sort -u
}

list_remote_hosts() {
  local current
  current="$(current_host)"

  list_known_hosts | awk -v current="$current" 'NF && (current == "" || $0 != current)'
}

host_target() {
  local name target
  name="$1"

  target="$(alias_target "$name")"
  if [ -z "$target" ]; then
    target="$name"
  fi

  if [ "$use_domain" -eq 1 ] && [ -n "$domain" ] && [[ "$target" != *.* ]]; then
    printf '%s\n' "${target}.${domain}"
  else
    printf '%s\n' "$target"
  fi
}

resolves() {
  local target
  target="$(host_target "$1")"

  if command -v getent >/dev/null 2>&1 && getent hosts "$target" >/dev/null 2>&1; then
    return 0
  fi

  if command -v dscacheutil >/dev/null 2>&1 && dscacheutil -q host -a name "$target" >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

tailscale_status=""

load_tailscale_status() {
  local status

  if ! command -v tailscale >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    return
  fi

  if status="$(tailscale status --json 2>/dev/null)" \
    && printf '%s\n' "$status" | jq -e . >/dev/null 2>&1; then
    tailscale_status="$status"
  fi
}

tailscale_target() {
  local name target
  name="$1"

  [ -n "$tailscale_status" ] || return 1

  target="$(
    printf '%s\n' "$tailscale_status" \
      | jq -r --arg host "$name" '
          [
            (.Peer // {})[]
            | select(.Online == true)
            | (.DNSName // "" | sub("\\.$"; "")) as $dns
            | select($dns != "")
            | select(
                ((.HostName // "") | ascii_downcase) == ($host | ascii_downcase)
                or (($dns | split(".")[0] | ascii_downcase) == ($host | ascii_downcase))
              )
            | $dns
          ][0] // empty
        '
  )"

  [ -n "$target" ] || return 1
  printf '%s\n' "$target"
}

route_host() {
  local name lan_target tail_target
  name="$1"
  lan_target="$(host_target "$name")"

  if resolves "$name"; then
    printf '%s  [LAN]\t%s\t%s\n' "$name" "$name" "$lan_target"
    return
  fi

  if tail_target="$(tailscale_target "$name")"; then
    printf '%s  [Tailscale]\t%s\t%s\n' "$name" "$name" "$tail_target"
    return
  fi

  return 1
}

list_routable_remote_hosts() {
  local name

  while IFS= read -r name; do
    route_host "$name" || true
  done < <(list_remote_hosts)
}

if [ "$use_domain" -eq 1 ] && [ -z "$domain" ]; then
  domain="$(detect_lan_domain 2>/dev/null || true)"
fi

load_tailscale_status

if [ -z "$host" ]; then
  routes="$(list_routable_remote_hosts | sort -u)"

  if [ -z "$routes" ]; then
    echo "sshto: no remote hosts resolve on this network after excluding current host '$(current_host)'" >&2
    exit 69
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "sshto: fzf is required when HOST is not supplied" >&2
    exit 69
  fi

  if [ "${SSHTO_ASSUME_TTY:-0}" != 1 ] && ! { : < /dev/tty > /dev/tty; } 2>/dev/null; then
    echo "sshto: HOST is required when no interactive terminal is available" >&2
    echo "sshto: available hosts:" >&2
    printf '%s\n' "$routes" | cut -f1 >&2
    exit 64
  fi

  prompt_domain="${domain:-no domain}"
  set +e
  selected_route="$(
    fzf --delimiter=$'\t' --with-nth=1 --prompt="herdr ${prompt_domain}> " \
      < <(printf '%s\n' "$routes")
  )"
  fzf_status=$?
  set -e

  if [ "$fzf_status" -ne 0 ]; then
    echo "sshto: no host selected" >&2
    exit "$fzf_status"
  fi

  if [ -z "$selected_route" ]; then
    echo "sshto: no host selected" >&2
    exit 1
  fi

  IFS=$'\t' read -r _ host target <<< "$selected_route"
else
  if selected_route="$(route_host "$host")"; then
    IFS=$'\t' read -r _ host target <<< "$selected_route"
  else
    target="$(host_target "$host")"
  fi
fi

remote_target="${user}@${target}"
command=(herdr --remote "$remote_target")

if [ -n "$session" ]; then
  command+=(--session "$session")
fi

case "$keybindings" in
  local|server) ;;
  *)
    echo "sshto: --keybindings must be local or server" >&2
    exit 64
    ;;
esac

command+=(--remote-keybindings "$keybindings")

if [ "$handoff" -eq 1 ]; then
  command+=(--handoff)
fi

if [ "${#herdr_args[@]}" -gt 0 ]; then
  command+=("${herdr_args[@]}")
fi

if [ "$print_only" -eq 1 ]; then
  printf '%q' "${command[@]:0:1}"
  printf ' %q' "${command[@]:1}"
  printf '\n'
  exit 0
fi

exec "${command[@]}"
