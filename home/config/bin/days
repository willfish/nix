#! /usr/bin/env fish

function usage
  echo "usage: days [N|all]" >&2
end

function fail
  echo "days: $argv" >&2
  exit 1
end

function iso_days_ago
  set -l n $argv[1]

  if date -d "$n days ago" +%Y-%m-%d >/dev/null 2>&1
    date -d "$n days ago" +%Y-%m-%d
  else
    date -v-"$n"d +%Y-%m-%d
  end
end

function ensure_notes_root
  set -l notes_root "$HOME/Notes"

  if not test -e "$notes_root"
    git clone git@github.com:willfish/notes.git "$notes_root"; or fail "failed to clone notes repository"
  else if not test -d "$notes_root"
    fail "notes path exists but is not a directory: $notes_root"
  end

  echo "$notes_root"
end

if test (count $argv) -gt 1
  usage
  exit 2
end

set -l cutoff (iso_days_ago 14); or fail "failed to compute cutoff date"
set -l header "daily notes, last 14 days"

if test (count $argv) -eq 1
  if test "$argv[1]" = all
    set cutoff
    set header "daily notes, newest first"
  else if string match -qr '^[1-9][0-9]*$' -- "$argv[1]"
    set cutoff (iso_days_ago "$argv[1]"); or fail "failed to compute cutoff date"
    set header "daily notes, last $argv[1] days"
  else
    usage
    exit 2
  end
end

set -l notes_root (ensure_notes_root); or exit 1
set -l daily_notes

for path in (find "$notes_root" -mindepth 2 -maxdepth 2 -type f -name today.md | sort)
  set -l rel (string replace -r "^$notes_root/" "" -- "$path")
  set -l on_date (string split -f1 / -- "$rel")

  if not string match -qr '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' -- "$on_date"
    continue
  end

  if test -n "$cutoff"
    set -l on_key (string replace -a -- - '' "$on_date")
    set -l cut_key (string replace -a -- - '' "$cutoff")
    if test "$on_key" -lt "$cut_key"
      continue
    end
  end

  set -a daily_notes "$rel"
end

if test (count $daily_notes) -eq 0
  fail "no daily notes found"
end

set -l selected (
  printf '%s\n' $daily_notes[-1..1] \
  | fzf --print-query --prompt 'days> ' --header "$header" --preview "head -n 40 '$notes_root'/{}" \
  | tail -1
)

if test -z "$selected"
  fail "no daily note selected"
end

if string match -qr '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' -- "$selected"
  set selected "$selected/today.md"
end

if not string match -qr '^[0-9]{4}-[0-9]{2}-[0-9]{2}/today.md$' -- "$selected"
  fail "not a daily note: $selected"
end

set -l on_date (string split -f1 / -- "$selected")
set -l fully_qualified_notes_file "$notes_root/$selected"

if not test -f "$fully_qualified_notes_file"
  exec notes_on "$on_date" today.md
end

nvim "$fully_qualified_notes_file"
