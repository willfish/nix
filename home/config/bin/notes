#! /usr/bin/env fish

function fail
  echo "notes: $argv" >&2
  exit 1
end

set -l notes_root "$HOME/Notes"

if not test -e "$notes_root"
  git clone git@github.com:willfish/notes.git "$notes_root"; or fail "failed to clone notes repository"
else if not test -d "$notes_root"
  fail "notes path exists but is not a directory: $notes_root"
end

set -l notes_file (
  find "$notes_root" \( -path "$notes_root/knowledge-base" -o -path "$notes_root/templates" \) -prune -o -type f -name "*.md" -print \
  | sed "s#^$notes_root/##" \
  | string match -r -v '^[0-9]{4}-[0-9]{2}-[0-9]{2}/' \
  | string match -r -v '^knowledge-base/' \
  | string match -r -v '^templates/' \
  | string match -r -v '(^|/)today\.md$' \
  | string match -r -v '(^|/)standup\.md$' \
  | string match -r -v '(^|/)README\.md$' \
  | fzf --print-query --prompt 'notes> ' --header 'topic notes (not daily files)' --preview "head -n 40 '$notes_root'/{}" \
  | tail -1
)

if test -z "$notes_file"
  fail "no notes file selected"
end

set -l fully_qualified_notes_file "$notes_root/$notes_file"

nvim "$fully_qualified_notes_file"
