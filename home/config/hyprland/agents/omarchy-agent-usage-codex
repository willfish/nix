#!/usr/bin/env python3
"""Codex subscription usage from Pi's openai-codex login.

The Codex CLI is not required. Pi's stored OAuth token calls the same
ChatGPT usage endpoint Pi's /usage command uses.
"""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import pi_auth
import usage_lib

USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
AUTH_HELP = "Run /login openai-codex in Pi."


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def probe(token: str, account_id: str) -> dict:
    headers = {"Authorization": "Bearer " + token, "Accept": "application/json"}
    if account_id:
        headers["ChatGPT-Account-Id"] = account_id
    request = urllib.request.Request(USAGE_URL, headers=headers)
    opener = urllib.request.build_opener(_NoRedirect)
    with opener.open(request, timeout=15) as response:
        payload = json.loads(response.read().decode("utf-8", errors="replace"))
    if not isinstance(payload, dict):
        raise RuntimeError("usage returned no object")
    return payload


def main() -> int:
    parser_args = {"force", "limits-only"}
    del parser_args
    if len(sys.argv) > 1 and sys.argv[1] in {"-h", "--help"}:
        print(
            "usage: omarchy-agent-usage-codex [--force] [--limits-only]",
            file=sys.stderr,
        )
        return 0
    home = Path(
        os.environ.get("PI_AGENT_DIR") or str(Path.home() / ".pi/agent")
    )
    stats = usage_lib.scan_pi_sessions(home / "sessions", "openai-codex")
    token, failure = pi_auth.oauth_access(
        "openai-codex", pi_auth.CODEX_TOKEN_URL, pi_auth.CODEX_CLIENT_ID
    )
    account = ""
    auth = pi_auth.read_json(home / "auth.json").get("openai-codex")
    if isinstance(auth, dict):
        account = str(auth.get("accountId") or "")
    limits: list = []
    tier = ""
    status = failure
    help_text = AUTH_HELP if failure else ""
    retry = False
    if token:
        try:
            payload = probe(token, account)
        except urllib.error.HTTPError as exc:
            status = "Codex limits unavailable"
            help_text = f"Codex usage returned status {exc.code}."
        except Exception:
            status = "Codex limits unavailable"
            help_text = (
                "Couldn't reach Codex usage. Local Pi stats are still shown."
            )
            retry = True
        else:
            limits, tier, status = usage_lib.parse_codex_wham(payload)
            help_text = ""
            if not limits and not status:
                status = "Codex limits unavailable"
                help_text = "Codex usage returned no allowance."
    record = usage_lib.record(
        "codex",
        "Codex",
        stats,
        limits=limits,
        tier=tier,
        status=status,
        help_text=help_text,
        retry=retry,
    )
    json.dump(record, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
