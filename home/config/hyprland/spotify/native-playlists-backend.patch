+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::protocol::{BackendState, Command};
+    use tokio::sync::mpsc;
+
+    #[tokio::test]
+    async fn playlist_reads_do_not_block_playback_controls() {
+        let (server, client) = UnixStream::pair().unwrap();
+        let (commands, mut requests) = mpsc::channel(8);
+        let task = tokio::spawn(client_loop(
+            server,
+            StateStore::new(BackendState::default()),
+            commands,
+        ));
+        let (reader, mut writer) = client.into_split();
+        let mut lines = BufReader::new(reader).lines();
+        lines.next_line().await.unwrap(); // Initial state.
+        writer.write_all(b"{\"v\":1,\"id\":1,\"command\":\"get_playlist\",\"uri\":\"spotify:playlist:37i9dQZF1DWSXMERUaiq9M\"}\n").await.unwrap();
+        let read = requests.recv().await.unwrap();
+        assert!(matches!(
+            read.command,
+            Command::GetPlaylist { offset: 0, .. }
+        ));
+        writer.write_all(b"{\"v\":1,\"id\":2,\"command\":\"ping\"}\n{\"v\":1,\"id\":3,\"command\":\"pause\"}\n").await.unwrap();
+        let control = tokio::time::timeout(std::time::Duration::from_secs(1), requests.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(control.command, Command::Pause);
+        control
+            .reply
+            .unwrap()
+            .send(Ok(serde_json::json!({})))
+            .unwrap();
+        for id in [2, 3] {
+            let line = tokio::time::timeout(std::time::Duration::from_secs(1), lines.next_line())
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap();
+            let reply: serde_json::Value = serde_json::from_str(&line).unwrap();
+            assert_eq!(reply["id"], id);
+            assert_eq!(reply["ok"], true);
+        }
+        read.reply
+            .unwrap()
+            .send(Ok(serde_json::json!({"items": []})))
+            .unwrap();
+        let line = tokio::time::timeout(std::time::Duration::from_secs(1), lines.next_line())
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&line).unwrap()["id"],
+            1
+        );
+        task.abort();
+    }
+}
