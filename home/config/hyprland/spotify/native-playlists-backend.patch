@@ -0,0 +1,191 @@
+//! Read-only playlist browsing through the authenticated playback session.
+use http::Method;
+use librespot_core::{Session, SpotifyUri};
+use librespot_metadata::{Episode, Metadata, Playlist, Track, image::Images};
+use protobuf::Message;
+use serde_json::{Value, json};
+use tokio::task::JoinSet;
+
+use crate::protocol::ProtocolError;
+
+const PAGE_SIZE: usize = 50;
+const METADATA_CONCURRENCY: usize = 4;
+
+fn error(message: &str) -> ProtocolError {
+    ProtocolError::new("playlist_error", message)
+}
+
+fn playlist_uri(uri: &str) -> Result<SpotifyUri, ProtocolError> {
+    match SpotifyUri::from_uri(uri) {
+        Ok(uri @ SpotifyUri::Playlist { .. }) => Ok(uri),
+        _ => Err(ProtocolError::new(
+            "invalid_request",
+            "Expected a Spotify playlist URI",
+        )),
+    }
+}
+
+fn next_offset(offset: usize, count: usize, total: usize) -> Result<Option<usize>, ProtocolError> {
+    let end = offset.saturating_add(count);
+    if count == 0 && offset < total {
+        return Err(error(
+            "Spotify returned an incomplete playlist page; try refreshing",
+        ));
+    }
+    Ok((end < total).then_some(end))
+}
+
+pub async fn playlist_page(
+    session: &Session,
+    uri: &str,
+    offset: usize,
+) -> Result<Value, ProtocolError> {
+    let uri = playlist_uri(uri)?;
+    let SpotifyUri::Playlist { id, .. } = &uri else {
+        unreachable!()
+    };
+    let endpoint = format!(
+        "/playlist/v2/playlist/{}?from={offset}&length={PAGE_SIZE}",
+        id.to_base62()
+    );
+    let bytes = session
+        .spclient()
+        .request(&Method::GET, &endpoint, None, None)
+        .await
+        .map_err(|_| error("Spotify could not read this playlist through the playback session"))?;
+    let message = <Playlist as Metadata>::Message::parse_from_bytes(&bytes)
+        .map_err(|_| error("Spotify returned an invalid playlist response"))?;
+    let playlist = Playlist::parse(&message, &uri)
+        .map_err(|_| error("Spotify returned unsupported playlist data"))?;
+    if playlist.contents.position < 0 || playlist.contents.position as usize != offset {
+        return Err(error(
+            "Spotify returned the wrong playlist page; try refreshing",
+        ));
+    }
+    let total = playlist.length.max(0) as usize;
+    // Some service versions ignore length. Never hydrate an unbounded response.
+    let items = &playlist.contents.items[..playlist.contents.items.len().min(PAGE_SIZE)];
+    let next = next_offset(offset, items.len(), total)?;
+    let mut rows = Vec::with_capacity(items.len());
+    for chunk in items.chunks(METADATA_CONCURRENCY) {
+        let mut pending = JoinSet::new();
+        for (index, item) in chunk.iter().enumerate() {
+            let session = session.clone();
+            let uri = item.id.clone();
+            pending.spawn(async move { (index, metadata(&session, &uri).await) });
+        }
+        let mut ordered = vec![Value::Null; chunk.len()];
+        while let Some(result) = pending.join_next().await {
+            let (index, row) = result.map_err(|_| error("Playlist metadata loading failed"))?;
+            let added = chunk[index].attributes.timestamp;
+            let added_at = format!(
+                "{:04}-{:02}-{:02}T{:02}:{:02}:{:02}Z",
+                added.year(),
+                added.month() as u8,
+                added.day(),
+                added.hour(),
+                added.minute(),
+                added.second()
+            );
+            ordered[index] = json!({"item": row, "added_at": added_at});
+        }
+        rows.extend(ordered);
+    }
+    Ok(json!({
+        "items": rows, "offset": offset, "total": total, "next_offset": next,
+        "name": playlist.attributes.name, "description": playlist.attributes.description,
+        "source": "librespot"
+    }))
+}
+
+fn images(covers: &Images) -> Vec<Value> {
+    covers
+        .iter()
+        .map(|image| {
+            json!({
+                "url": format!("https://i.scdn.co/image/{}", image.id.to_base16()),
+                "width": image.width, "height": image.height
+            })
+        })
+        .collect()
+}
+
+fn identity(uri: &SpotifyUri, kind: &str, name: &str) -> Value {
+    let uri = uri.to_uri();
+    json!({"type": kind, "id": uri.rsplit(':').next().unwrap_or(""), "uri": uri, "name": name})
+}
+
+async fn metadata(session: &Session, uri: &SpotifyUri) -> Value {
+    match uri {
+        SpotifyUri::Track { .. } => {
+            if let Ok(track) = Track::get(session, uri).await {
+                let mut result = identity(uri, "track", &track.name);
+                let mut album = identity(&track.album.id, "album", &track.album.name);
+                album["images"] = json!(images(&track.album.covers));
+                result["album"] = album;
+                result["artists"] = track
+                    .artists
+                    .iter()
+                    .map(|artist| identity(&artist.id, "artist", &artist.name))
+                    .collect();
+                result["duration_ms"] = json!(track.duration);
+                result["explicit"] = json!(track.is_explicit);
+                result["track_number"] = json!(track.number);
+                result["disc_number"] = json!(track.disc_number);
+                return result;
+            }
+        }
+        SpotifyUri::Episode { .. } => {
+            if let Ok(episode) = Episode::get(session, uri).await {
+                let mut result = identity(uri, "episode", &episode.name);
+                result["show"] = json!({"name": episode.show_name});
+                result["images"] = json!(images(&episode.covers));
+                result["duration_ms"] = json!(episode.duration);
+                result["explicit"] = json!(episode.is_explicit);
+                return result;
+            }
+        }
+        _ => {}
+    }
+    // Keep the original position, including duplicates and unavailable/local
+    // entries, so scrolling and playlist offset controls never shift tracks.
+    let kind = if matches!(uri, SpotifyUri::Episode { .. }) {
+        "episode"
+    } else {
+        "track"
+    };
+    let mut result = identity(uri, kind, "Unavailable item");
+    result["is_playable"] = json!(false);
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pagination_keeps_positions_and_detects_missing_pages() {
+        assert_eq!(next_offset(0, 50, 100).unwrap(), Some(50));
+        assert_eq!(next_offset(50, 50, 100).unwrap(), None);
+        assert_eq!(next_offset(100, 3, 103).unwrap(), None);
+        assert_eq!(next_offset(0, 0, 0).unwrap(), None);
+        assert!(next_offset(50, 0, 100).is_err());
+    }
+
+    #[test]
+    fn only_playlist_uris_can_reach_the_playlist_service() {
+        assert!(playlist_uri("spotify:playlist:37i9dQZF1DWSXMERUaiq9M").is_ok());
+        assert!(playlist_uri("spotify:track:14XWXWv5FoCbFzLksawpEe").is_err());
+        assert!(playlist_uri("https://example.invalid").is_err());
+    }
+
+    #[tokio::test]
+    async fn unsupported_items_keep_their_original_uri() {
+        let session = Session::new(Default::default(), None);
+        let uri = SpotifyUri::from_uri("spotify:album:37i9dQZF1DWSXMERUaiq9M").unwrap();
+        let row = metadata(&session, &uri).await;
+        assert_eq!(row["uri"], uri.to_uri());
+        assert_eq!(row["name"], "Unavailable item");
+        assert_eq!(row["is_playable"], false);
+    }
+}
