+++ b/tests/integration/NativePlaylistBackend.qml
@@ -0,0 +1,66 @@
+import QtQuick
+import Quickshell
+import "../.." as Plugin
+
+// Run with quickshell, whose Quickshell modules are statically linked.
+ShellRoot {
+  id: root
+  Plugin.BackendClient { id: client }
+
+  function check(value, message) {
+    if (!value) throw new Error(message)
+  }
+
+  Timer {
+    interval: 10
+    running: true
+    onTriggered: {
+      var calls = 0
+      client.pending = { "7": { deadline: 100, callback: function(ok, result, error) {
+        calls++
+        root.check(ok && result.source === "librespot" && error === "", "Native response")
+      } } }
+      var line = JSON.stringify({type: "response", id: 7, ok: true,
+        result: {source: "librespot"}})
+      client.handleLine(line)
+      client.handleLine(line)
+      root.check(calls === 1 && Object.keys(client.pending).length === 0,
+        "Late replies must not call waiters twice")
+
+      calls = 0
+      client.pending = {
+        "1": { deadline: 100, callback: function(ok, result, error) {
+          calls++
+          root.check(!ok && error.indexOf("timed out") >= 0, "Timeout error")
+        } },
+        "2": { deadline: 200, callback: null }
+      }
+      client.expirePending(100)
+      root.check(calls === 1 && Object.keys(client.pending).length === 1,
+        "Only expired waiters should finish")
+      client.expirePending(200)
+      root.check(calls === 1 && Object.keys(client.pending).length === 0,
+        "Empty callbacks must also expire")
+
+      calls = 0
+      client.pending = { "1": { deadline: 100, callback: function(ok, result, error) {
+        calls++
+        root.check(!ok && error === "disconnected", "Disconnect error")
+      } } }
+      client.resetPending("disconnected")
+      root.check(calls === 1 && Object.keys(client.pending).length === 0,
+        "Disconnect must finish waiters")
+
+      calls = 0
+      client.playlistPage("37i9dQZF1DWSXMERUaiq9M", 0, function(status, result, error) {
+        calls++
+        root.check(status === 503 && result === null
+          && error.indexOf("native Spotify backend") >= 0,
+          "Unavailable backend must report an error, not fall back to the Web API")
+      })
+      root.check(calls === 1, "Unavailable callback")
+      console.log("NATIVE_PLAYLIST_BACKEND_PASS: response, timeout, disconnect, unavailable")
+      Qt.quit()
+    }
+  }
+}
