+def run_pi(prompt: str, timeout: float, max_bytes: int = MAX_AGENT_OUTPUT_CHARS,
+           model: str | None = None) -> subprocess.CompletedProcess:
+    """
+    Rank through Pi so the call uses Pi's provider login instead of a
+    separate Claude or Codex CLI. The prompt contains untrusted abstracts.
+    Tools, extensions (including MCP), skills, themes, and project context
+    are off, and the session is not saved. Thinking is off so the reply
+    stays inside the scan timeout and is the requested JSON rather than a
+    reasoning trace. The binary path is substituted at package build time.
+    """
+    chosen = (model or "").strip() or DEFAULT_PI_MODEL
+    scratch_dir = tempfile.mkdtemp(prefix="arxiv-scanner-pi-")
+    try:
+        argv = [
+            "__ARXIV_PI__",
+            "--print",
+            "--mode", "text",
+            "--no-tools",
+            "--no-extensions",
+            "--no-skills",
+            "--no-prompt-templates",
+            "--no-context-files",
+            "--no-themes",
+            "--no-session",
+            "--no-approve",
+            "--thinking", "off",
+            "--model", chosen,
+            "--system-prompt",
+            "You filter arXiv submissions. You have no tools. Follow the user message exactly and return only the requested JSON.",
+            "--",
+            "Follow the task in the preceding stdin text.",
+        ]
+        env = os.environ.copy()
+        env["PI_AGENT_BUS_ENABLED"] = "0"
+        env.pop("CAPTURE_PROMPTS", None)
+        return _run_agent_subprocess(argv, prompt, timeout, max_bytes, env=env, cwd=scratch_dir)
+    finally:
+        shutil.rmtree(scratch_dir, ignore_errors=True)
+
+
+AGENT_BACKENDS = {"pi": run_pi, "claude": run_claude, "codex": run_codex}


