def matches(path, asset):
    if not path.is_file() or path.stat().st_size != asset["bytes"]:
        return False
    with path.open("rb") as source:
        return (
            hashlib.file_digest(source, "sha256").hexdigest() == asset["sha256"]
        )


def install(root, asset, check_only=False):
    destination = root / asset["path"]
    if matches(destination, asset):
        print(f"Verified {destination}", flush=True)
        return
    if check_only:
        raise ValueError(f"Missing or invalid model: {destination}")
    destination.parent.mkdir(parents=True, exist_ok=True)
    for attempt in range(3):
        temporary = None
        try:
            print(
                f"Downloading {asset['path']} ({asset['bytes']:,} bytes)",
                flush=True,
            )
            digest = hashlib.sha256()
            received = 0
            with tempfile.NamedTemporaryFile(
                dir=destination.parent, suffix=".partial", delete=False
            ) as target:
                temporary = Path(target.name)
                request = urllib.request.Request(
                    asset["url"],
                    headers={"User-Agent": "pi-voice-model-setup"},
                )
                with urllib.request.urlopen(request, timeout=30) as response:
                    while chunk := response.read(1024 * 1024):
                        received += len(chunk)
                        if received > asset["bytes"]:
                            raise ValueError(
                                f"Download exceeds expected size: {asset['path']}"
                            )
                        digest.update(chunk)
                        target.write(chunk)
                target.flush()
                os.fsync(target.fileno())
            if (
                received != asset["bytes"]
                or digest.hexdigest() != asset["sha256"]
            ):
                raise ValueError(
                    f"Model integrity check failed: {asset['path']}"
                )
            temporary.replace(destination)
            print(f"Installed {destination}", flush=True)
            return
        except (OSError, urllib.error.URLError):
            if attempt == 2:
                raise
            time.sleep(attempt + 1)
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--data-dir",
        type=Path,
        default=Path(
            os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")
        )
        / "pi-voice",
    )
    parser.add_argument(
        "--check-only",
        action="store_true",
        help="Verify local assets without downloading",
    )
    parser.add_argument(
        "--experimental",
        action="store_true",
        help="Also install larger Qwen3, DotTTS and PocketTTS assets",
    )
    parser.add_argument(
        "--stt-only",
        action="store_true",
        help="Install Whisper recognition assets only, skipping TTS models",
    )
    parser.add_argument(
        "--host",
        default=socket.gethostname(),
        help="Install host-specific speech models for this machine",
    )
    args = parser.parse_args()
    for asset in ASSETS:
        if args.stt_only and asset.get("role") != "stt":
            continue
        hosts = asset.get("hosts")
        if hosts and args.host not in hosts:
            continue
        if not asset["experimental"] or args.experimental:
            install(args.data_dir, asset, args.check_only)


if __name__ == "__main__":
    main()
