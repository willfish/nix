#!/usr/bin/env bash
set -euo pipefail

flake="."
host="$(hostname)"
home_config=""
out_dir=""
summary=0
limit=15
color="auto"
scope="auto"
from_nh=0
nix_args=(--no-write-lock-file)

usage() {
  cat >&2 <<'USAGE'
usage: scripts/nix-storage-costs [--flake REF] [--scope auto|system|home|both] [--host HOST] [--home HOME_CONFIG] [--out-dir DIR] [--summary] [--limit N] [--color auto|always|never]

Builds the selected outputs, then reports closure costs
for the package/program roots defined by those configurations.

Defaults:
  --flake   .
  --host    $(hostname)
  --scope   both on Linux, home on Darwin
  --home    william@HOST or william-linux on Linux; william-darwin on Darwin
  --out-dir ${XDG_STATE_HOME:-$HOME/.local/state}/nix-storage-costs
  --limit   15
USAGE
}

skip_nh_report() {
  echo "Storage-cost callback skipped: $*" >&2
  return 1
}

parse_nh_switch() {
  [ "$#" -ge 2 ] && [ "$2" = switch ] || return 1
  case "$1" in
    os) scope=system; flake="${NH_OS_FLAKE:-${NH_FLAKE:-}}" ;;
    home) scope=home; flake="${NH_HOME_FLAKE:-${NH_FLAKE:-}}" ;;
    *) return 1 ;;
  esac
  shift 2
  from_nh=1
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -n|--dry|-h|--help) return 1 ;;
      -H|--hostname) host="$2"; shift 2 ;;
      --hostname=*) host="${1#*=}"; shift ;;
      -H?*) host="${1#-H}"; shift ;;
      -c|--configuration) home_config="$2"; shift 2 ;;
      --configuration=*) home_config="${1#*=}"; shift ;;
      -c?*) home_config="${1#-c}"; shift ;;
      --override-input|--override-input=*)
        skip_nh_report "input overrides require an explicit report"; return 1 ;;
      --option)
        nix_args+=("$1" "$2" "$3"); shift 3 ;;
      -I|--include)
        nix_args+=("$1" "$2"); shift 2 ;;
      --impure|--offline|--accept-flake-config|--show-trace|--no-update-lock-file|--no-write-lock-file|--no-use-registries|--no-registries)
        nix_args+=("$1"); shift ;;
      --no-net) nix_args+=(--offline); shift ;;
      -o|--out-link|-d|--diff|-j|--max-jobs|--cores|--log-format|--builders|-e|--elevation-strategy|-b|--backup-extension|-U|--update-input)
        shift 2 ;;
      --out-link=*|--diff=*|--max-jobs=*|--cores=*|--log-format=*|--builders=*|--elevation-strategy=*|--backup-extension=*|--update-input=*)
        shift ;;
      -v|-vv|-vvv|--verbose|-q|-qq|-qqq|--quiet|-a|--ask|--no-nom|-k|--keep-going|-K|--keep-failed|--fallback|--repair|-L|--print-build-logs|-t|-Q|--no-build-output|--use-substitutes|--json|-u|--update|-S|--no-specialisation|--show-activation-logs|--install-bootloader|-R|--bypass-root-check|--no-validate)
        shift ;;
      --)
        shift
        if [ "$#" -gt 0 ]; then
          skip_nh_report "extra Nix arguments require an explicit report"
          return 1
        fi ;;
      -*) skip_nh_report "unsupported nh option $1"; return 1 ;;
      *) flake="$1"; shift ;;
    esac
  done
  if [ -z "$flake" ]; then
    skip_nh_report "no explicit flake or NH flake environment variable"
    return 1
  fi
  case "$flake" in
    *'#'*|/nix/store/*) skip_nh_report "attribute/store installables require an explicit report"; return 1 ;;
  esac
}

# Both shells forward the successful nh invocation intact. Keep its argument
# selection here so option values cannot accidentally become a flake path.
if [ "${1:-}" = --after-nh-switch ]; then
  shift
  parse_nh_switch "$@" || exit 0
  set -- --summary --limit 12
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --flake)
      flake="$2"
      shift 2
      ;;
    --scope)
      scope="$2"
      shift 2
      ;;
    --host)
      host="$2"
      shift 2
      ;;
    --home)
      home_config="$2"
      shift 2
      ;;
    --out-dir)
      out_dir="$2"
      shift 2
      ;;
    --summary)
      summary=1
      shift
      ;;
    --limit)
      limit="$2"
      shift 2
      ;;
    --color)
      color="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 64
      ;;
  esac
done

if [ -z "$out_dir" ]; then
  state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  out_dir="$state_home/nix-storage-costs"
fi

platform="$(uname -s)"
if [ "$scope" = auto ]; then
  if [ "$platform" = Darwin ]; then scope=home; else scope=both; fi
fi
case "$scope" in
  system|home|both) ;;
  *) echo "--scope must be auto, system, home or both" >&2; exit 64 ;;
esac
if [ -d "$flake" ]; then
  flake_path="$(realpath "$flake")"
else
  flake_path="$flake"
fi
if [ "$from_nh" -eq 1 ]; then
  case "$flake_path" in
    /nix/store/*)
      skip_nh_report "resolved store installables require an explicit report" || exit 0
      ;;
  esac
fi
export NIX_STORAGE_COST_FLAKE="$flake_path"
export NIX_STORAGE_COST_HOST="$host"
export NIX_STORAGE_COST_SCOPE="$scope"
export NIX_STORAGE_COST_PLATFORM="$platform"
export NIX_STORAGE_COST_FROM_NH="$from_nh"
export NIX_STORAGE_COST_USER
NIX_STORAGE_COST_USER="$(whoami)"

if [ "$scope" != system ] && [ -z "$home_config" ]; then
  # Match nh's username@hostname / username fallback for an implicit selection.
  # Direct reports retain the dotfiles platform defaults.
  # shellcheck disable=SC2016
  home_config="$(nix eval "${nix_args[@]}" --impure --raw --expr '
    let
      f = builtins.getFlake (builtins.getEnv "NIX_STORAGE_COST_FLAKE");
      host = builtins.getEnv "NIX_STORAGE_COST_HOST";
      user = builtins.getEnv "NIX_STORAGE_COST_USER";
      candidates =
        if builtins.getEnv "NIX_STORAGE_COST_FROM_NH" == "1" then [ "${user}@${host}" user ]
        else if builtins.getEnv "NIX_STORAGE_COST_PLATFORM" == "Darwin" then [ "william-darwin" ]
        else [ "william@${host}" "william-linux" ];
      matching = builtins.filter (name: builtins.hasAttr name f.homeConfigurations) candidates;
    in
      if matching == [] then throw "No matching Home Manager configuration; pass --home"
      else builtins.head matching
  ')"
fi

case "$limit" in
  ''|*[!0-9]*)
    echo "--limit must be a positive integer" >&2
    exit 64
    ;;
esac

if [ "$limit" -lt 1 ]; then
  echo "--limit must be a positive integer" >&2
  exit 64
fi

case "$color" in
  auto|always|never) ;;
  *)
    echo "--color must be one of: auto, always, never" >&2
    exit 64
    ;;
esac

mkdir -p "$out_dir"

system_path=""
home_path=""
if [ "$scope" != home ]; then
  echo "Building NixOS system for ${host}..."
  system_path="$(
    nix build "${nix_args[@]}" --no-link --print-out-paths \
      "${flake_path}#nixosConfigurations.\"${host}\".config.system.build.toplevel"
  )"
fi
if [ "$scope" != system ]; then
  echo "Building Home Manager activation package for ${home_config}..."
  home_path="$(
    nix build "${nix_args[@]}" --no-link --print-out-paths \
      "${flake_path}#homeConfigurations.\"${home_config}\".activationPackage"
  )"
fi

inventory_json="$(mktemp)"
trap 'rm -f "$inventory_json"' EXIT

export NIX_STORAGE_COST_HOME="$home_config"

# shellcheck disable=SC2016
nix eval "${nix_args[@]}" --impure --json --expr '
let
  flake = builtins.getFlake (builtins.getEnv "NIX_STORAGE_COST_FLAKE");
  host = builtins.getEnv "NIX_STORAGE_COST_HOST";
  homeName = builtins.getEnv "NIX_STORAGE_COST_HOME";
  scope = builtins.getEnv "NIX_STORAGE_COST_SCOPE";
  lib = flake.inputs.nixpkgs.lib;
  nixos = flake.nixosConfigurations.${host}.config;
  home = flake.homeConfigurations.${homeName}.config;

  item = source: label: p: {
    inherit source label;
    pname = p.pname or (p.name or label);
    name = p.name or (p.pname or label);
    storePath = builtins.toString p;
  };

  items = source: label: ps: builtins.map (p: item source label p) ps;

  optionalItem = source: label: value:
    let result = builtins.tryEval value;
    in if result.success && result.value != null then [ (item source label result.value) ] else [ ];

  optionalPath = source: path: root:
    optionalItem source (lib.concatStringsSep "." path) (lib.attrByPath path null root);
in
  (lib.optionals (scope != "home") (
    (items "nixos" "environment.systemPackages" nixos.environment.systemPackages)
    ++ (items "nixos" "users.users.william.packages" nixos.users.users.william.packages)
    ++ (items "nixos" "fonts.packages" nixos.fonts.packages)
    ++ (items "nixos" "environment.shells" nixos.environment.shells)
    ++ (optionalItem "nixos" "users.defaultUserShell" nixos.users.defaultUserShell)
    ++ (optionalItem "nixos" "programs.fish.package" nixos.programs.fish.package)
    ++ (optionalItem "nixos" "virtualisation.docker.package" nixos.virtualisation.docker.package)
    ++ (optionalItem "nixos" "boot.kernelPackages.kernel" nixos.boot.kernelPackages.kernel)
    ++ (optionalPath "nixos" [ "services" "pipewire" "package" ] nixos)
    ++ (optionalPath "nixos" [ "services" "openssh" "package" ] nixos)
    ++ (optionalPath "nixos" [ "services" "avahi" "package" ] nixos)
    ++ (optionalPath "nixos" [ "services" "printing" "package" ] nixos)
  )) ++ (lib.optionals (scope != "system") (
    (items "home-manager" "home.packages/evaluated" home.home.packages)
    ++ (optionalItem "home-manager" "programs.git.package" home.programs.git.package)
    ++ (optionalItem "home-manager" "programs.fish.package" home.programs.fish.package)
    ++ (optionalItem "home-manager" "programs.tmux.package" home.programs.tmux.package)
    ++ (optionalItem "home-manager" "programs.zoxide.package" home.programs.zoxide.package)
    ++ (optionalItem "home-manager" "programs.direnv.package" home.programs.direnv.package)
    ++ lib.optionals (home.programs ? brave) (optionalItem "home-manager" "programs.brave.package" home.programs.brave.package)
    ++ lib.optionals (home.programs ? google-chrome) (optionalItem "home-manager" "programs.google-chrome.package" home.programs.google-chrome.package)
  ))
' > "$inventory_json"

python3 - "$inventory_json" "$system_path" "$home_path" "$host" "$home_config" "$out_dir" "$summary" "$limit" "$color" <<'PY'
import csv
import json
import subprocess
import sys
from collections import Counter, defaultdict
from datetime import datetime, timezone
from pathlib import Path

inventory_file, system_path, home_path, host, home_config, out_dir, summary, limit, color = sys.argv[1:]
out_dir = Path(out_dir)
summary = summary == "1"
limit = int(limit)
use_color = color == "always" or (color == "auto" and sys.stdout.isatty())

with open(inventory_file) as f:
    entries = json.load(f)

by_path = {}
for entry in entries:
    path = entry["storePath"]
    current = by_path.setdefault(
        path,
        {
            "storePath": path,
            "name": entry["name"],
            "pname": entry["pname"],
            "sources": set(),
            "labels": set(),
        },
    )
    current["sources"].add(entry["source"])
    current["labels"].add(entry["label"])

roots = sorted(by_path)

def run_lines(args):
    return subprocess.check_output(args, text=True).splitlines()

def is_valid_store_path(path):
    """True when path is registered and present in the local store.

    Evaluated package attrs (e.g. programs.brave.package) can point at a
    base derivation that was never realized, while home.packages installs an
    overridden variant. nix-store -qR fails hard on unrealized paths.
    """
    try:
        subprocess.run(
            ["nix-store", "--query", "--hash", path],
            check=True,
            capture_output=True,
            text=True,
        )
        return True
    except subprocess.CalledProcessError:
        return False

skipped = []
valid_roots = []
for root in roots:
    if is_valid_store_path(root):
        valid_roots.append(root)
    else:
        data = by_path[root]
        skipped.append(
            {
                "store_path": root,
                "name": data["name"],
                "labels": ",".join(sorted(data["labels"])),
                "sources": ",".join(sorted(data["sources"])),
            }
        )

if skipped:
    print(
        f"warning: skipping {len(skipped)} unrealized inventory root(s) "
        f"(evaluated package path not present in local store):",
        file=sys.stderr,
    )
    for item in skipped:
        print(
            f"  - {item['name']} ({item['labels']}) -> {item['store_path']}",
            file=sys.stderr,
        )

roots = valid_roots

closures = {}
all_paths = set()
for root in roots:
    paths = run_lines(["nix-store", "-qR", root])
    closures[root] = paths
    all_paths.update(paths)

def chunks(values, size):
    values = list(values)
    for index in range(0, len(values), size):
        yield values[index:index + size]

sizes = {}
for chunk in chunks(sorted(all_paths | {path for path in (system_path, home_path) if path}), 400):
    info = json.loads(subprocess.check_output(["nix", "path-info", "--json", *chunk], text=True))
    for path, metadata in info.items():
        if not metadata:
            # Unrealized or unknown to the daemon; treat as zero rather than crash.
            sizes[path] = 0
            continue
        sizes[path] = int(metadata.get("narSize") or 0)

def closure_size(path):
    info = json.loads(subprocess.check_output(["nix", "path-info", "--json", "-S", path], text=True))
    return int(info[path]["closureSize"])

ref_counts = Counter()
for paths in closures.values():
    ref_counts.update(paths)

rows = []
for root in roots:
    data = by_path[root]
    paths = closures[root]
    rows.append(
        {
            "name": data["name"],
            "pname": data["pname"],
            "sources": ",".join(sorted(data["sources"])),
            "labels": ",".join(sorted(data["labels"])),
            "store_path": root,
            "direct_bytes": sizes.get(root, 0),
            "closure_bytes": sum(sizes[p] for p in paths),
            "unique_inventory_bytes": sum(sizes[p] for p in paths if ref_counts[p] == 1),
            "closure_paths": len(paths),
            "unique_inventory_paths": sum(1 for p in paths if ref_counts[p] == 1),
        }
    )

rows.sort(key=lambda row: (row["unique_inventory_bytes"], row["closure_bytes"]), reverse=True)

total_inventory_closure = sum(sizes[p] for p in all_paths)
system_closure = closure_size(system_path) if system_path else 0
home_closure = closure_size(home_path) if home_path else 0

groups = {}
for row in rows:
    group = groups.setdefault(
        row["name"],
        {
            "name": row["name"],
            "sources": set(),
            "labels": set(),
            "store_paths": [],
            "closure_paths_set": set(),
            "direct_bytes": 0,
        },
    )
    group["sources"].update(row["sources"].split(","))
    group["labels"].update(row["labels"].split(","))
    group["store_paths"].append(row["store_path"])
    group["closure_paths_set"].update(closures[row["store_path"]])
    group["direct_bytes"] += row["direct_bytes"]

grouped_rows = []
for group in groups.values():
    closure_paths = group["closure_paths_set"]
    grouped_rows.append(
        {
            "name": group["name"],
            "sources": ",".join(sorted(group["sources"])),
            "labels": ",".join(sorted(group["labels"])),
            "root_count": len(group["store_paths"]),
            "direct_bytes": group["direct_bytes"],
            "closure_bytes": sum(sizes[p] for p in closure_paths),
            "unique_inventory_bytes": sum(sizes[p] for p in closure_paths if ref_counts[p] == 1),
        }
    )

grouped_rows.sort(key=lambda row: (row["unique_inventory_bytes"], row["closure_bytes"]), reverse=True)

def human(bytes_value):
    value = float(bytes_value)
    for unit in ["B", "KiB", "MiB", "GiB", "TiB"]:
        if value < 1024 or unit == "TiB":
            return f"{value:.1f} {unit}" if unit != "B" else f"{int(value)} B"
        value /= 1024
    return f"{value:.1f} TiB"

def paint(text, code):
    if not use_color:
        return text
    return f"\033[{code}m{text}\033[0m"

def trunc(text, width):
    if len(text) <= width:
        return text
    if width <= 3:
        return text[:width]
    return text[: max(0, width - 3)] + "..."

def display_sources(sources):
    return sources.replace("home-manager", "home")

def table_line(columns, widths):
    return "  ".join(str(value).ljust(width) for value, width in zip(columns, widths))

safe_home = home_config.replace("@", "_").replace("/", "_") or "system"
prefix = out_dir / f"{host}-{safe_home}-storage-costs"
csv_path = prefix.with_suffix(".csv")
md_path = prefix.with_suffix(".md")

row_fields = [
    "name",
    "pname",
    "sources",
    "labels",
    "store_path",
    "direct_bytes",
    "closure_bytes",
    "unique_inventory_bytes",
    "closure_paths",
    "unique_inventory_paths",
]
with csv_path.open("w", newline="") as f:
    writer = csv.DictWriter(f, fieldnames=row_fields)
    writer.writeheader()
    writer.writerows(rows)

top_rows = grouped_rows[:40]
source_totals = defaultdict(int)
for row in rows:
    for source in row["sources"].split(","):
        source_totals[source] += row["unique_inventory_bytes"]

generated = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
with md_path.open("w") as f:
    f.write(f"# Storage Costs for {host}\n\n")
    f.write(f"Generated: {generated}\n\n")
    f.write("## Scope\n\n")
    if system_path:
        f.write(f"- NixOS system: `{system_path}`\n")
    if home_path:
        f.write(f"- Home Manager: `{home_config}` -> `{home_path}`\n")
    f.write(f"- Inventory roots: {len(rows)} de-duplicated store paths\n")
    if skipped:
        f.write(
            f"- Skipped unrealized roots: {len(skipped)} "
            f"(evaluated package paths not present in the local store)\n"
        )
    f.write(f"- Inventory closure: {human(total_inventory_closure)}\n")
    if system_path:
        f.write(f"- NixOS system closure: {human(system_closure)}\n")
    if home_path:
        f.write(f"- Home Manager activation closure: {human(home_closure)}\n")
    f.write("\n")
    f.write("`closure` is the full dependency closure for that root. `unique` is the subset of that closure referenced by only one root in this inventory; it is the better first-pass signal for storage you might save by removing one item from these package/program roots.\n\n")
    if skipped:
        f.write("## Skipped Unrealized Roots\n\n")
        f.write(
            "These package attribute paths were evaluated from the flake but are not "
            "realized locally (common when Home Manager installs an overridden variant "
            "of `programs.<name>.package`). They are omitted from size accounting.\n\n"
        )
        f.write("| Package | Source | Labels | Store path |\n")
        f.write("| --- | --- | --- | --- |\n")
        for item in skipped:
            f.write(
                f"| `{item['name']}` | `{item['sources']}` | `{item['labels']}` | "
                f"`{item['store_path']}` |\n"
            )
        f.write("\n")
    f.write("## Unique Storage by Source\n\n")
    f.write("| Source | Unique |\n")
    f.write("| --- | ---: |\n")
    for source, bytes_value in sorted(source_totals.items(), key=lambda item: item[1], reverse=True):
        f.write(f"| `{source}` | {human(bytes_value)} |\n")
    f.write("\n## Top Packages by Unique Inventory Size\n\n")
    f.write("| Package | Roots | Source | Unique | Closure | Direct | Labels |\n")
    f.write("| --- | ---: | --- | ---: | ---: | ---: | --- |\n")
    for row in top_rows:
        f.write(
            f"| `{row['name']}` | {row['root_count']} | `{row['sources']}` | {human(row['unique_inventory_bytes'])} | "
            f"{human(row['closure_bytes'])} | {human(row['direct_bytes'])} | `{row['labels']}` |\n"
        )
    f.write(f"\nFull CSV: `{csv_path}`\n")

print(md_path)
print(csv_path)
print(f"inventory_roots={len(rows)}")
print(f"skipped_unrealized_roots={len(skipped)}")
print(f"inventory_closure={human(total_inventory_closure)}")
print(f"system_closure={human(system_closure)}")
print(f"home_closure={human(home_closure)}")

if summary:
    visible_rows = grouped_rows[:limit]
    name_width = min(
        36,
        max([len("Package")] + [len(row["name"]) for row in visible_rows] or [len("Package")]),
    )
    source_width = min(
        14,
        max(
            [len("Source")]
            + [len(display_sources(row["sources"])) for row in visible_rows]
            or [len("Source")]
        ),
    )
    widths = [name_width, 5, source_width, 11, 11, 11]

    print()
    print(paint(f"Storage costs for {host} ({home_config or 'NixOS'})", "1;36"))
    print(
        f"Inventory {paint(human(total_inventory_closure), '1;33')}  "
        + (f"NixOS {paint(human(system_closure), '1;32')}  " if system_path else "")
        + (f"Home {paint(human(home_closure), '1;32')}  " if home_path else "")
        + f"Roots {paint(str(len(rows)), '1;34')}"
        + (
            f"  Skipped {paint(str(len(skipped)), '1;33')}"
            if skipped
            else ""
        )
    )
    print()
    if visible_rows:
        print(paint(table_line(["Package", "Roots", "Source", "Unique", "Closure", "Direct"], widths), "1"))
        print(paint(table_line(["-" * width for width in widths], widths), "2"))
        for row in visible_rows:
            unique = row["unique_inventory_bytes"]
            unique_color = "31" if unique >= 1024**3 else "33" if unique >= 512 * 1024**2 else "0"
            print(
                table_line(
                    [
                        trunc(row["name"], name_width),
                        row["root_count"],
                        trunc(display_sources(row["sources"]), source_width),
                        paint(human(unique), unique_color),
                        human(row["closure_bytes"]),
                        human(row["direct_bytes"]),
                    ],
                    widths,
                )
            )
    else:
        print(paint("No realized inventory roots to report.", "33"))
    print()
    print(f"Full report: {paint(str(md_path), '36')}")
    print(f"CSV:         {paint(str(csv_path), '36')}")
PY
